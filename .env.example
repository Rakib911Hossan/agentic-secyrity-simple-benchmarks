SECRET_KEY=change-this-to-a-random-value
FERNET_KEY=
MODE=secure
SESSION_COOKIE_SECURE=false

# Optional SMTP (leave blank to log emails to the console instead)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Optional: powers the AI pentest agent on the admin dashboard
# (validation_suite/llm_agent.py). Leave blank to disable that feature only
# — everything else in the app works without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional extra keys: the agent rotates to the next one when a key hits a
# quota/rate limit (429 RESOURCE_EXHAUSTED). Use either a comma-separated
# list OR the numbered form — both are picked up.
GEMINI_API_KEYS=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
